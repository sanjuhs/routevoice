/* ENGINEERING PROXY, NOT CHARACTERIZED SIGNOFF LIBRARY.
W6 sampled SS settle23.376321ns from WL command; integrated PC->WL20ns.
PC->OUT delay44ns=20ns + rounded24ns. No clock pin is invented.
WL loads2pF / PC10pF are provisional sensitivity assumptions.
Power intentionally absent: missing does NOT mean zero macro power.
60ns measured partial-array reuse is recorded in sidecar, not a clock contract.
No WL->OUT arcs: PC-referenced protocol proxy does not cover decoder hazards.
*/
library (PITCH_BANK_R1280_ENGINEERING_PROXY) {
 delay_model : table_lookup;
 time_unit : "1ns";
 voltage_unit : "1V";
 current_unit : "1mA";
 pulling_resistance_unit : "1kohm";
 capacitive_load_unit (1,pf);
 leakage_power_unit : "1nW";
 nom_process : 1;
 nom_voltage : 2.97;
 nom_temperature : 125;
 default_input_pin_cap : 2.0;
 default_output_pin_cap : 0.0;
 lu_table_template (constant_1x1) {
  variable_1 : input_net_transition;
  variable_2 : total_output_net_capacitance;
  index_1 ("0.2");
  index_2 ("0.01");
 }
 cell (PITCH_BANK_R1280) {
  area : 2267845.24;
  dont_use : true;
  pg_pin (VDD) { voltage_name : VDD; pg_type : primary_power; }
  pg_pin (VSS) { voltage_name : VSS; pg_type : primary_ground; }
  pin (PC) { direction : input; capacitance : 10.0; related_power_pin : VDD; related_ground_pin : VSS; }
  pin (WL0) { direction : input; capacitance : 2.0; related_power_pin : VDD; related_ground_pin : VSS; }
